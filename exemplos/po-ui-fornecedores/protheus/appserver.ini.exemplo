; Trecho para ADICIONAR ao appserver.ini existente (nao substitua o arquivo).
; Ajuste porta, environment e origem do CORS ao seu ambiente.
; Este e o REST do Framework Protheus (HTTPV11 + PrepareIn), o mesmo usado
; pelas skills deste repositorio. Se apos reiniciar o AppServer as rotas
; nao aparecerem em http://localhost:8080/rest/swagger, confira na TDN a
; pagina "tlppCore - REST - Configuracao" para a versao do seu binario.

[HTTPV11]
Enable=1
Sockets=HTTPREST

[HTTPREST]
Port=8080
IPsBind=
URIs=HTTPURI
Security=1

[HTTPURI]
URL=/rest
; Environment do seu appserver.ini (ex.: P12, PROTHEUS, ENVIRONMENT)
PrepareIn=ALL
Instances=1,2
; CORS fica nesta secao (a do URL=/rest). E obrigatorio para o app aberto
; pelo FwCallApp, que roda na porta do WebApp e chama a API nesta porta.
; Em producao, troque * pela origem do WebApp (ex.: http://servidor:4002).
CORSEnable=1
AllowOrigin=*

[ONSTART]
JOBS=HTTPJOB
RefreshRate=120

[HTTPJOB]
MAIN=HTTP_START
ENVIRONMENT=P12
